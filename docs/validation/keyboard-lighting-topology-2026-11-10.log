    "https://github.com/tuxedocomputers/tuxedo-drivers/blob/main/src/uniwill_interfaces.h",
    "https://github.com/tuxedocomputers/tuxedo-drivers/blob/main/src/uniwill_leds.h"
  ],
  "conclusion": "High confidence current platform exposes single-zone RGB, no supported per-key path found. Spatial per-key wave/ripple/reactive effects cannot be implemented with verified interfaces. Whole-board color cycling/breathing/key-triggered flashing may be possible; not validated in this read-only investigation. Unknown hidden firmware paths or alternate hardware variants are not exhaustively disproven.",
  "product_hwmon_bound": true
}
